{
  "name": "local-first-rewards",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/admin-portal", "apps/business-portal", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "supabase db push",
    "db:generate": "supabase gen types typescript --local > packages/shared/src/types/supabase.ts"
  },
  "dependencies": {
    "expo": "~52.0.0"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7",
    "prettier": "^3.2.5",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
