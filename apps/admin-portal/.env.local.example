# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin portal only — restrict access to admin roles at the Supabase RLS level
ADMIN_JWT_SECRET=your-admin-jwt-secret

# Stripe (for revenue analytics)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_BUSINESS_PORTAL_URL=http://localhost:3001

# Firebase (push notifications — server-side)
FIREBASE_SERVER_KEY=your_firebase_server_key_here

# Edge function / cron security
CRON_SECRET=your_cron_secret_here

# Google Vision API (receipt OCR)
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
